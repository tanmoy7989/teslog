# Copy to project root as .env:  cp config/.env.example .env
# Generate secrets:  ./scripts/init-secrets.sh

# --- TeslaMate (shared across stack) ---
TM_ENCRYPTION_KEY=
TM_DB_USER=teslamate
TM_DB_PASS=
TM_DB_NAME=teslamate
TM_TZ=America/Los_Angeles

# --- Teslog app database (separate DB on same Postgres instance) ---
TESLOG_DB_NAME=teslog
TESLOG_DB_USER=teslog
TESLOG_DB_PASS=

# --- Teslog settings ---
TESLOG_HOST=0.0.0.0
TESLOG_PORT=8080
TESLOG_CAR_ID=1
# How often (seconds) to check TeslaMate for newly completed drives
TESLOG_SYNC_INTERVAL_SECONDS=900

# TeslaMateApi base URL (inside Docker network)
TESLAMATE_API_URL=http://teslamateapi:8080

# OSRM routing server for the route-vs-odometer metric. The public demo server
# is fine for light personal use and needs no signup/API key. For heavier or
# production use, point this at a self-hosted OSRM instance instead.
OSRM_BASE_URL=https://router.project-osrm.org

# How often (hours) and where (folder in the rclone 'gdrive' remote) './teslog.sh up'
# exports Teslog's combined stats CSV to Google Drive. Set by 'setup' (defaults below) and by
# 'up's --export-hours/--export-location flags — not meant to be hand-edited. Requires a
# one-time `rclone config` first — see README.md.
TESLOG_EXPORT_FREQUENCY_HOURS=24
TESLOG_EXPORT_LOCATION=teslog
